# Default: authored demo, local file persistence, no external API/database calls.
IFFY_MODE=demo
CORS_ORIGIN=http://localhost:5175
IFFY_DATA_DIR=.local-data

# Optional private live mode: apply both SQL migrations first.
# IFFY_MODE=live
# IFFY_API_TOKEN=
# GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
AI_MAX_RETRIES=1
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
